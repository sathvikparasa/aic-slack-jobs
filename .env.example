# Default webhook for all sources. Comma-separate several URLs to post to multiple channels/workspaces.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional per-source overrides (post to different channels)
# SLACK_WEBHOOK_URL_INTERN=
# SLACK_WEBHOOK_URL_NEWGRAD=
POLL_INTERVAL_SECONDS=120
MAX_AGE_HOURS=72
LOG_LEVEL=INFO
